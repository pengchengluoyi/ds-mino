{
  "name": "ds-mino",
  "version": "0.1.11",
  "type": "module",
  "description": "在 DSH 里打开 ds-mino",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./assets/*": "./lib/assets/*"
  },
  "files": [
    "index.js",
    "lib",
    "workbench/src",
    "workbench/public",
    "workbench/index.html",
    "workbench/vite.config.ts",
    "workbench/tsconfig.json",
    "workbench/tsconfig.app.json",
    "workbench/tsconfig.node.json",
    "workbench/package.json",
    "workbench/package-lock.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
